{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Activity Receipt",
  "$id": "https://github.com/blakegaucher/ai-activity-receipt/blob/main/activity-receipt.schema.json",
  "$comment": "Candidate non-normative schema profile: candidate-v0.2",
  "description": "Candidate, non-normative schema for a human-centered provenance record of consequential AI-agent activity.",
  "type": "object",
  "required": [
    "receipt_id",
    "trace_id",
    "record_schema_version",
    "receipt_version",
    "system",
    "authority",
    "material_sources",
    "material_actions",
    "verification",
    "incidents",
    "integrity"
  ],
  "properties": {
    "receipt_id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique identifier for this Receipt."
    },
    "trace_id": {
      "type": "string",
      "minLength": 1,
      "description": "Identifier linking the Receipt to the underlying agent run or trace."
    },
    "record_schema_version": {
      "type": "string",
      "minLength": 1
    },
    "receipt_version": {
      "type": "string",
      "minLength": 1
    },
    "system": {
      "type": "object",
      "required": [
        "agent_id",
        "version"
      ],
      "properties": {
        "agent_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string"
        },
        "model": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "authority": {
      "type": "object",
      "required": [
        "principal",
        "delegate",
        "scope",
        "valid_from",
        "valid_until"
      ],
      "properties": {
        "principal": {
          "type": "string",
          "minLength": 1
        },
        "delegate": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "prohibited": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "valid_from": {
          "type": "string",
          "format": "date-time"
        },
        "valid_until": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "material_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "role"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "uri": {
            "type": "string"
          },
          "hash": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "material_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "operation",
          "status",
          "authorization",
          "event_id",
          "occurred_at"
        ],
        "properties": {
          "operation": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "completed",
              "blocked",
              "failed",
              "pending",
              "unknown"
            ]
          },
          "authorization": {
            "type": "string",
            "enum": [
              "approved",
              "denied",
              "not_required",
              "unknown"
            ]
          },
          "consequential": {
            "type": "boolean"
          },
          "event_id": {
            "type": "string",
            "minLength": 1
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time"
          },
          "authorization_decided_at": {
            "type": "string",
            "format": "date-time"
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "verification": {
      "type": "object",
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "not_required",
            "pending",
            "confirmed",
            "failed",
            "uncertain"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "incidents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1
          },
          "event_id": {
            "type": "string"
          },
          "mitigation": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "integrity": {
      "type": "object",
      "required": [
        "record_hash",
        "derived_from_record_hash",
        "generated_at"
      ],
      "properties": {
        "record_hash": {
          "type": "string",
          "pattern": "^sha256:.+$"
        },
        "previous_record_hash": {
          "type": "string",
          "pattern": "^sha256:.+$"
        },
        "derived_from_record_hash": {
          "type": "string",
          "pattern": "^sha256:.+$"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
