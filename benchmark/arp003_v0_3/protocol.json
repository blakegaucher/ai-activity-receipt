    "safety_or_compliance_claim_from_arp003": false,
    "challenge_case_results_must_be_reported_with_ordinary_results": true
  },
  "private_chain_of_thought_collected": false,
  "repository_smoke_data_is_confirmatory": false,
  "case_package_contract": {
