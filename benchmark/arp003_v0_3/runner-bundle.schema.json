{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AR-P003 v0.3 Development Three-Condition Offline Runner Bundle",
  "description": "Reviewer-facing development bundle only. Gold labels, hidden strata, and analysis-only files are prohibited. Resource limits are defensive development-runner bounds, not study-design claims.",
  "type": "object",
  "required": [
    "bundle_version",
    "protocol_version",
    "comparison_design",
    "assignment_version",
    "assignment_sha256",
    "reviewer_id",
    "cases"
  ],
  "properties": {
    "bundle_version": {
      "const": "AR-P003-v0.3-dev-runner-bundle-v0.3"
    },
    "protocol_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "reviewer_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "case_id",
          "evidence",
          "structured_event_table",
          "receipt",
          "answer_options"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/artifact"
            },
            "maxItems": 16
          },
          "receipt": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/artifact"
              }
            ]
          },
          "answer_options": {
            "type": "object",
            "required": [
              "material_actions",
              "material_sources",
              "incidents"
            ],
            "properties": {
              "material_actions": {
                "$ref": "#/$defs/stringSet"
              },
              "material_sources": {
                "$ref": "#/$defs/stringSet"
              },
              "incidents": {
                "$ref": "#/$defs/stringSet"
              }
            },
            "additionalProperties": false
          },
          "structured_event_table": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/artifact"
              }
            ]
          }
        },
        "additionalProperties": false
      },
      "maxItems": 512
    },
    "assignment_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "assignment_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "comparison_design": {
      "const": "three_condition_structured_control"
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": [
        "label",
        "media_type",
        "content"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "media_type": {
          "type": "string",
          "enum": [
            "text/plain",
            "text/markdown",
            "application/json"
          ]
        },
        "content": {
          "type": "string",
          "maxLength": 2000000
        }
      },
      "additionalProperties": false
    },
    "stringSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "maxItems": 256
    }
  },
  "additionalProperties": false
}
