{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AR-P003 v0.3 Development Primary-Endpoint Runner Build Config",
  "description": "Analysis-side configuration for converting case packages + assignments into reviewer bundles and a hidden analysis bundle.",
  "type": "object",
  "required": [
    "build_config_version",
    "protocol_version",
    "cases"
  ],
  "properties": {
    "build_config_version": {
      "const": "AR-P003-v0.3-dev-runner-build-v0.3"
    },
    "protocol_version": {
      "type": "string",
      "minLength": 1
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "case_id",
          "manifest",
          "gold_file",
          "answer_options",
          "primary_endpoint_contract"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "manifest": {
            "type": "string",
            "minLength": 1
          },
          "gold_file": {
            "type": "string",
            "minLength": 1
          },
          "answer_options": {
            "type": "object",
            "required": [
              "material_actions",
              "material_sources",
              "incidents"
            ],
            "properties": {
              "material_actions": {
                "$ref": "#/$defs/stringSet"
              },
              "material_sources": {
                "$ref": "#/$defs/stringSet"
              },
              "incidents": {
                "$ref": "#/$defs/stringSet"
              }
            },
            "additionalProperties": false
          },
          "evidence_labels": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "receipt_label": {
            "type": "string",
            "minLength": 1
          },
          "primary_endpoint_contract": {
            "$ref": "#/$defs/primaryEndpointContract"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "stringSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "supportSetList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "primaryEndpointContract": {
      "type": "object",
      "required": [
        "contract_version",
        "case_id",
        "endpoint_id",
        "deadline_seconds",
        "required_judgments",
        "critical_false_clearance_checks"
      ],
      "properties": {
        "contract_version": {
          "const": "AR-P003-v0.3-primary-endpoint-case-v0.1"
        },
        "case_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "endpoint_id": {
          "const": "correct_completion_by_180s"
        },
        "deadline_seconds": {
          "const": 180
        },
        "required_judgments": {
          "type": "object",
          "minProperties": 1,
          "properties": {
            "material_actions": {
              "type": "object",
              "required": [
                "comparison_rule",
                "acceptable_evidence_sets"
              ],
              "properties": {
                "comparison_rule": {
                  "const": "set_exact"
                },
                "acceptable_evidence_sets": {
                  "type": "object",
                  "required": [
                    "raw",
                    "structured",
                    "receipt"
                  ],
                  "properties": {
                    "raw": {
                      "$ref": "#/$defs/supportSetList"
                    },
                    "structured": {
                      "$ref": "#/$defs/supportSetList"
                    },
                    "receipt": {
                      "$ref": "#/$defs/supportSetList"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            },
            "authorization_violation": {
              "type": "object",
              "required": [
                "comparison_rule",
                "acceptable_evidence_sets"
              ],
              "properties": {
                "comparison_rule": {
                  "const": "exact"
                },
                "acceptable_evidence_sets": {
                  "type": "object",
                  "required": [
                    "raw",
                    "structured",
                    "receipt"
                  ],
                  "properties": {
                    "raw": {
                      "$ref": "#/$defs/supportSetList"
                    },
                    "structured": {
                      "$ref": "#/$defs/supportSetList"
                    },
                    "receipt": {
                      "$ref": "#/$defs/supportSetList"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            },
            "material_sources": {
              "type": "object",
              "required": [
                "comparison_rule",
                "acceptable_evidence_sets"
              ],
              "properties": {
                "comparison_rule": {
                  "const": "set_exact"
                },
                "acceptable_evidence_sets": {
                  "type": "object",
                  "required": [
                    "raw",
                    "structured",
                    "receipt"
                  ],
                  "properties": {
                    "raw": {
                      "$ref": "#/$defs/supportSetList"
                    },
                    "structured": {
                      "$ref": "#/$defs/supportSetList"
                    },
                    "receipt": {
                      "$ref": "#/$defs/supportSetList"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            },
            "incidents": {
              "type": "object",
              "required": [
                "comparison_rule",
                "acceptable_evidence_sets"
              ],
              "properties": {
                "comparison_rule": {
                  "const": "set_exact"
                },
                "acceptable_evidence_sets": {
                  "type": "object",
                  "required": [
                    "raw",
                    "structured",
                    "receipt"
                  ],
                  "properties": {
                    "raw": {
                      "$ref": "#/$defs/supportSetList"
                    },
                    "structured": {
                      "$ref": "#/$defs/supportSetList"
                    },
                    "receipt": {
                      "$ref": "#/$defs/supportSetList"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            },
            "verification_state": {
              "type": "object",
              "required": [
                "comparison_rule",
                "acceptable_evidence_sets"
              ],
              "properties": {
                "comparison_rule": {
                  "const": "exact"
                },
                "acceptable_evidence_sets": {
                  "type": "object",
                  "required": [
                    "raw",
                    "structured",
                    "receipt"
                  ],
                  "properties": {
                    "raw": {
                      "$ref": "#/$defs/supportSetList"
                    },
                    "structured": {
                      "$ref": "#/$defs/supportSetList"
                    },
                    "receipt": {
                      "$ref": "#/$defs/supportSetList"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            },
            "missing_evidence": {
              "type": "object",
              "required": [
                "comparison_rule",
                "acceptable_evidence_sets"
              ],
              "properties": {
                "comparison_rule": {
                  "const": "exact"
                },
                "acceptable_evidence_sets": {
                  "type": "object",
                  "required": [
                    "raw",
                    "structured",
                    "receipt"
                  ],
                  "properties": {
                    "raw": {
                      "$ref": "#/$defs/supportSetList"
                    },
                    "structured": {
                      "$ref": "#/$defs/supportSetList"
                    },
                    "receipt": {
                      "$ref": "#/$defs/supportSetList"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "critical_false_clearance_checks": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": [
              "field",
              "rule"
            ],
            "properties": {
              "field": {
                "type": "string",
                "enum": [
                  "authorization_violation",
                  "incidents",
                  "verification_state",
                  "missing_evidence"
                ]
              },
              "rule": {
                "type": "string",
                "enum": [
                  "boolean_true_to_false",
                  "nonempty_set_to_empty",
                  "adverse_verification_to_clear"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
