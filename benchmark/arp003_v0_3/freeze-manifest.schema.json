{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AR-P003 v0.3 Freeze Manifest",
  "description": "Content-bound manifest for AR-P003 freeze artifacts. This is a deterministic integrity record, not a digital signature or trusted timestamp.",
  "type": "object",
  "required": [
    "manifest_version",
    "protocol_id",
    "protocol_version",
    "protocol_frozen",
    "protocol_path",
    "protocol_sha256",
    "generated_at",
    "hash_algorithm",
    "artifact_set_sha256",
    "freeze_content_id",
    "artifacts"
  ],
  "properties": {
    "manifest_version": {
      "const": "AR-P003-v0.3-freeze-manifest-v0.2"
    },
    "protocol_id": {
      "const": "AR-P003"
    },
    "protocol_version": {
      "type": "string",
      "minLength": 1
    },
    "protocol_frozen": {
      "type": "boolean"
    },
    "protocol_path": {
      "type": "string",
      "minLength": 1
    },
    "protocol_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "hash_algorithm": {
      "const": "sha256"
    },
    "artifact_set_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "freeze_content_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "bytes",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
