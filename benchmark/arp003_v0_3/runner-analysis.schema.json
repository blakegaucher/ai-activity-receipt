{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AR-P003 v0.3 Development Endpoint-Aware Integrated-Challenge Analysis Bundle",
  "description": "Analysis-side hidden case metadata. This file must never be reviewer-facing. Defensive limits mirror reviewer-side cardinality bounds where applicable.",
  "type": "object",
  "required": [
    "analysis_bundle_version",
    "protocol_version",
    "comparison_design",
    "challenge_design",
    "primary_endpoint",
    "cases"
  ],
  "properties": {
    "analysis_bundle_version": {
      "const": "AR-P003-v0.3-dev-runner-analysis-v0.4"
    },
    "protocol_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "case_id",
          "stratum",
          "gold",
          "primary_endpoint_contract"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "stratum": {
            "type": "string",
            "enum": [
              "ordinary",
              "stale_receipt",
              "incomplete_receipt",
              "conflicting_receipt"
            ]
          },
          "gold": {
            "$ref": "#/$defs/reconstruction"
          },
          "primary_endpoint_contract": {
            "$ref": "#/$defs/primaryEndpointContract"
          }
        },
        "additionalProperties": false
      },
      "maxItems": 512
    },
    "comparison_design": {
      "const": "three_condition_structured_control"
    },
    "challenge_design": {
      "const": "integrated_challenge_strata"
    },
    "primary_endpoint": {
      "$ref": "#/$defs/publicPrimaryEndpoint"
    }
  },
  "$defs": {
    "stringSet": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "uniqueItems": true,
      "maxItems": 256
    },
    "verificationState": {
      "type": "string",
      "enum": [
        "not_required",
        "pending",
        "confirmed",
        "failed",
        "uncertain"
      ]
    },
    "reconstruction": {
      "type": "object",
      "required": [
        "material_actions",
        "authorization_violation",
        "material_sources",
        "incidents",
        "verification_state",
        "missing_evidence"
      ],
      "properties": {
        "material_actions": {
          "$ref": "#/$defs/stringSet"
        },
        "authorization_violation": {
          "type": "boolean"
        },
        "material_sources": {
          "$ref": "#/$defs/stringSet"
        },
        "incidents": {
          "$ref": "#/$defs/stringSet"
        },
        "verification_state": {
          "$ref": "#/$defs/verificationState"
        },
        "missing_evidence": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "supportSetList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "publicPrimaryEndpoint": {
      "type": "object",
      "required": [
        "endpoint_id",
        "deadline_seconds",
        "primary_timing_clock",
        "timing_candidates",
        "timeout_enforcement"
      ],
      "properties": {
        "endpoint_id": {
          "const": "correct_completion_by_180s"
        },
        "deadline_seconds": {
          "const": 180
        },
        "primary_timing_clock": {
          "const": "unresolved"
        },
        "timing_candidates": {
          "type": "array",
          "const": [
            "active_time_primary",
            "wall_deadline_with_hidden_sensitivity"
          ]
        },
        "timeout_enforcement": {
          "const": "development_not_enforced_until_primary_timing_clock_selected"
        }
      },
      "additionalProperties": false
    },
    "primaryEndpointContract": {
      "type": "object",
      "required": [
        "contract_version",
        "case_id",
        "endpoint_id",
        "deadline_seconds",
        "required_judgments",
        "critical_false_clearance_checks"
      ],
      "properties": {
        "contract_version": {
          "const": "AR-P003-v0.3-primary-endpoint-case-v0.1"
        },
        "case_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "endpoint_id": {
          "const": "correct_completion_by_180s"
        },
        "deadline_seconds": {
          "const": 180
        },
        "required_judgments": {
          "type": "object",
          "minProperties": 1,
          "properties": {
            "material_actions": {
              "type": "object",
              "required": [
                "comparison_rule",
                "acceptable_evidence_sets"
              ],
              "properties": {
                "comparison_rule": {
                  "const": "set_exact"
                },
                "acceptable_evidence_sets": {
                  "type": "object",
                  "required": [
                    "raw",
                    "structured",
                    "receipt"
                  ],
                  "properties": {
                    "raw": {
                      "$ref": "#/$defs/supportSetList"
                    },
                    "structured": {
                      "$ref": "#/$defs/supportSetList"
                    },
                    "receipt": {
                      "$ref": "#/$defs/supportSetList"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            },
            "authorization_violation": {
              "type": "object",
              "required": [
                "comparison_rule",
                "acceptable_evidence_sets"
              ],
              "properties": {
                "comparison_rule": {
                  "const": "exact"
                },
                "acceptable_evidence_sets": {
                  "type": "object",
                  "required": [
                    "raw",
                    "structured",
                    "receipt"
                  ],
                  "properties": {
                    "raw": {
                      "$ref": "#/$defs/supportSetList"
                    },
                    "structured": {
                      "$ref": "#/$defs/supportSetList"
                    },
                    "receipt": {
                      "$ref": "#/$defs/supportSetList"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            },
            "material_sources": {
              "type": "object",
              "required": [
                "comparison_rule",
                "acceptable_evidence_sets"
              ],
              "properties": {
                "comparison_rule": {
                  "const": "set_exact"
                },
                "acceptable_evidence_sets": {
                  "type": "object",
                  "required": [
                    "raw",
                    "structured",
                    "receipt"
                  ],
                  "properties": {
                    "raw": {
                      "$ref": "#/$defs/supportSetList"
                    },
                    "structured": {
                      "$ref": "#/$defs/supportSetList"
                    },
                    "receipt": {
                      "$ref": "#/$defs/supportSetList"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            },
            "incidents": {
              "type": "object",
              "required": [
                "comparison_rule",
                "acceptable_evidence_sets"
              ],
              "properties": {
                "comparison_rule": {
                  "const": "set_exact"
                },
                "acceptable_evidence_sets": {
                  "type": "object",
                  "required": [
                    "raw",
                    "structured",
                    "receipt"
                  ],
                  "properties": {
                    "raw": {
                      "$ref": "#/$defs/supportSetList"
                    },
                    "structured": {
                      "$ref": "#/$defs/supportSetList"
                    },
                    "receipt": {
                      "$ref": "#/$defs/supportSetList"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            },
            "verification_state": {
              "type": "object",
              "required": [
                "comparison_rule",
                "acceptable_evidence_sets"
              ],
              "properties": {
                "comparison_rule": {
                  "const": "exact"
                },
                "acceptable_evidence_sets": {
                  "type": "object",
                  "required": [
                    "raw",
                    "structured",
                    "receipt"
                  ],
                  "properties": {
                    "raw": {
                      "$ref": "#/$defs/supportSetList"
                    },
                    "structured": {
                      "$ref": "#/$defs/supportSetList"
                    },
                    "receipt": {
                      "$ref": "#/$defs/supportSetList"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            },
            "missing_evidence": {
              "type": "object",
              "required": [
                "comparison_rule",
                "acceptable_evidence_sets"
              ],
              "properties": {
                "comparison_rule": {
                  "const": "exact"
                },
                "acceptable_evidence_sets": {
                  "type": "object",
                  "required": [
                    "raw",
                    "structured",
                    "receipt"
                  ],
                  "properties": {
                    "raw": {
                      "$ref": "#/$defs/supportSetList"
                    },
                    "structured": {
                      "$ref": "#/$defs/supportSetList"
                    },
                    "receipt": {
                      "$ref": "#/$defs/supportSetList"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "critical_false_clearance_checks": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": [
              "field",
              "rule"
            ],
            "properties": {
              "field": {
                "type": "string",
                "enum": [
                  "authorization_violation",
                  "incidents",
                  "verification_state",
                  "missing_evidence"
                ]
              },
              "rule": {
                "type": "string",
                "enum": [
                  "boolean_true_to_false",
                  "nonempty_set_to_empty",
                  "adverse_verification_to_clear"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
