{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AR-P003 v0.3 Development Three-Condition Runner Analysis Bundle",
  "description": "Analysis-side hidden case metadata. This file must never be reviewer-facing. Defensive limits mirror reviewer-side cardinality bounds where applicable.",
  "type": "object",
  "required": [
    "analysis_bundle_version",
    "protocol_version",
    "comparison_design",
    "cases"
  ],
  "properties": {
    "analysis_bundle_version": {
      "const": "AR-P003-v0.3-dev-runner-analysis-v0.2"
    },
    "protocol_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "case_id",
          "stratum",
          "gold"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "stratum": {
            "type": "string",
            "enum": [
              "ordinary",
              "stale_receipt",
              "incomplete_receipt",
              "conflicting_receipt"
            ]
          },
          "gold": {
            "$ref": "#/$defs/reconstruction"
          }
        },
        "additionalProperties": false
      },
      "maxItems": 512
    },
    "comparison_design": {
      "const": "three_condition_structured_control"
    }
  },
  "$defs": {
    "stringSet": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "uniqueItems": true,
      "maxItems": 256
    },
    "verificationState": {
      "type": "string",
      "enum": [
        "not_required",
        "pending",
        "confirmed",
        "failed",
        "uncertain"
      ]
    },
    "reconstruction": {
      "type": "object",
      "required": [
        "material_actions",
        "authorization_violation",
        "material_sources",
        "incidents",
        "verification_state",
        "missing_evidence"
      ],
      "properties": {
        "material_actions": {
          "$ref": "#/$defs/stringSet"
        },
        "authorization_violation": {
          "type": "boolean"
        },
        "material_sources": {
          "$ref": "#/$defs/stringSet"
        },
        "incidents": {
          "$ref": "#/$defs/stringSet"
        },
        "verification_state": {
          "$ref": "#/$defs/verificationState"
        },
        "missing_evidence": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
