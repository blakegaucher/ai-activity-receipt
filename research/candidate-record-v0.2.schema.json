{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Activity Record — Multi-Hop Delegation Research Profile",
  "$id": "https://github.com/blakegaucher/ai-activity-receipt/blob/main/research/candidate-record-v0.2.schema.json",
  "$comment": "Research-only future canonical-record profile: candidate-record-v0.2",
  "description": "Research-only future canonical Activity Record profile with one active multi-hop delegation chain per record. It does not replace candidate-record-v0.1.",
  "type": "object",
  "required": [
    "record_id",
    "record_schema_version",
    "trace_id",
    "system",
    "actors",
    "authority_chain",
    "sources",
    "events",
    "verification",
    "incidents",
    "integrity"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "record_schema_version": {
      "const": "candidate-record-v0.2"
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "system": {
      "type": "object",
      "required": [
        "agent_id",
        "version"
      ],
      "properties": {
        "agent_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string"
        },
        "model": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "actors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "actor_id",
          "kind"
        ],
        "properties": {
          "actor_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "human",
              "agent",
              "organization",
              "tool",
              "service"
            ]
          },
          "role": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "role",
          "material"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "material": {
            "type": "boolean"
          },
          "uri": {
            "type": "string"
          },
          "hash": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "event_id",
          "occurred_at",
          "actor_id",
          "operation",
          "status",
          "authorization",
          "consequential",
          "material"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "minLength": 1
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time"
          },
          "actor_id": {
            "type": "string",
            "minLength": 1
          },
          "operation": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "completed",
              "blocked",
              "failed",
              "pending",
              "unknown"
            ]
          },
          "authorization": {
            "type": "string",
            "enum": [
              "approved",
              "denied",
              "not_required",
              "unknown"
            ]
          },
          "authorization_decided_at": {
            "type": "string",
            "format": "date-time"
          },
          "consequential": {
            "type": "boolean"
          },
          "material": {
            "type": "boolean"
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "verification": {
      "type": "object",
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "not_required",
            "pending",
            "confirmed",
            "failed",
            "uncertain"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "incidents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1
          },
          "event_id": {
            "type": "string",
            "minLength": 1
          },
          "mitigation": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "integrity": {
      "type": "object",
      "required": [
        "generated_at"
      ],
      "properties": {
        "previous_record_hash": {
          "type": "string",
          "pattern": "^sha256:.+$"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "notes": {
      "type": "string"
    },
    "authority_chain": {
      "type": "object",
      "required": [
        "root_principal",
        "current_actor",
        "evidence_state",
        "hops"
      ],
      "properties": {
        "root_principal": {
          "type": "string",
          "minLength": 1
        },
        "current_actor": {
          "type": "string",
          "minLength": 1
        },
        "evidence_state": {
          "type": "string",
          "enum": [
            "complete",
            "legacy_partial"
          ]
        },
        "hops": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "hop_id",
              "delegator",
              "delegate",
              "scope",
              "prohibited",
              "valid_from",
              "valid_until",
              "decision_time_state",
              "state"
            ],
            "properties": {
              "hop_id": {
                "type": "string",
                "minLength": 1
              },
              "delegator": {
                "type": "string",
                "minLength": 1
              },
              "delegate": {
                "type": "string",
                "minLength": 1
              },
              "scope": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "prohibited": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "valid_from": {
                "type": "string",
                "format": "date-time"
              },
              "valid_until": {
                "type": "string",
                "format": "date-time"
              },
              "decision_time_state": {
                "type": "string",
                "enum": [
                  "recorded",
                  "legacy_not_recorded"
                ]
              },
              "decided_at": {
                "type": "string",
                "format": "date-time"
              },
              "evidence_ref": {
                "type": "string",
                "minLength": 1
              },
              "state": {
                "type": "string",
                "enum": [
                  "active",
                  "revoked",
                  "invalid"
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "decision_time_state": {
                      "const": "recorded"
                    }
                  },
                  "required": [
                    "decision_time_state"
                  ]
                },
                "then": {
                  "required": [
                    "decided_at"
                  ]
                }
              }
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
