{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Activity Receipt DSSE Research Envelope",
  "description": "Research-only constrained DSSE v1 envelope profile used by the Activity Receipt prototype.",
  "type": "object",
  "required": [
    "payloadType",
    "payload",
    "signatures"
  ],
  "properties": {
    "payloadType": {
      "type": "string",
      "format": "uri"
    },
    "payload": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]*={0,2}$"
    },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "keyid",
          "sig"
        ],
        "properties": {
          "keyid": {
            "type": "string",
            "minLength": 1
          },
          "sig": {
            "type": "string",
            "pattern": "^[A-Za-z0-9+/]+={0,2}$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
